# ==============================================================================
# Aspirin LMS: Environment Configuration
# Copy this file to .env or .env.local and populate the secrets.
# ==============================================================================

# Clerk Authentication (Get these from your Clerk Dashboard: https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_JWT_KEY="your_clerk_pem_public_key"

# Cloudflare D1 Database (Configured in wrangler.jsonc)
# Local development uses local SQLite file in .wrangler/state/v3/d1
DATABASE_NAME=yui-db

# Microsoft 365 / SharePoint & OneDrive Media Backend
ONEDRIVE_CLIENT_ID=ba92c830-fac7-4d60-a0ff-8bf0b581a4c4
ONEDRIVE_TENANT_ID=938a1924-0af0-4599-819b-177a1dcf8fd6
ONEDRIVE_DRIVE_TARGET=sites/root/drive
# Note: ONEDRIVE_CLIENT_SECRET and ONEDRIVE_REFRESH_TOKEN are stored in GitHub Secrets
# and local credentials files (onedrive_token.json).

# Telegram MTProto Sourcing (Local ingestion only, never exposed to client)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash